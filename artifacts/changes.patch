@@ -0,0 +1,14 @@
+<!doctype html>
+<html lang="zh-CN">
+<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Geo Panel</title><link rel="stylesheet" href="panel.css"></head>
+<body>
+  <header><span class="logo">◎</span><div><h1>Geo Panel</h1><p>地理位置侧栏 · 本地运行</p></div><span class="badge">0.1</span></header>
+  <main>
+    <section class="hero"><span class="eyebrow">CURRENT LOCATION</span><h2>每一个坐标，<br>都通向一个地方。</h2><p>读取当前加载的街景位置，或粘贴坐标查看地图。</p><button id="read" class="primary">◎ 读取当前位置</button></section>
